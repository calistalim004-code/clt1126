.f-bzyd textarea{background:var(--t6)}
.f-zxn textarea{background:var(--t5)}
select{font:inherit;color:var(--ink);background:var(--card);border:2px solid var(--line);border-radius:999px;padding:8px 14px}
nav .wbtn{margin-top:8px;border:2px dashed var(--line);border-radius:16px}
.zhrow{display:grid;grid-template-columns:minmax(90px,.35fr) 1fr auto;gap:8px;align-items:start;margin-bottom:8px}
