const EMPTYL='<ul><li><br></li></ul>';
const OKT=new Set(['DIV','P','BR','B','STRONG','I','EM','U','UL','OL','LI','SPAN','MARK']);
function cleanHtml(h){
  const doc=new DOMParser().parseFromString('<body>'+h,'text/html');
  const out=document.createElement('div');
  (function walk(src,dst){
    src.childNodes.forEach(n=>{
      if(n.nodeType===3){dst.appendChild(document.createTextNode(n.nodeValue));return;}
      if(n.nodeType!==1||n.tagName==='SCRIPT'||n.tagName==='STYLE')return;
      if(!OKT.has(n.tagName)){walk(n,dst);return;}
      const e=document.createElement(n.tagName.toLowerCase()),st=n.getAttribute('style')||'';
      let s='';
      const ta=/text-align:\s*(left|center|right)/i.exec(st);if(ta)s+='text-align:'+ta[1].toLowerCase()+';';
      const bc=/background-color:\s*(#[0-9a-f]{3,8}|rgb\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*\))/i.exec(st);if(bc)s+='background-color:'+bc[1]+';';
      if(s)e.setAttribute('style',s);
      walk(n,e);dst.appendChild(e);
    });
  })(doc.body,out);
  return out.innerHTML;
}
function plainText(s){
  s=String(s==null?'':s);
  if(!/<\/?(div|br|b|strong|p|span|ul|ol|li|i|em|u|mark)\b/i.test(s))return s;
  const h=s.replace(/<br\s*\/?>/gi,'\n').replace(/<\/(div|p|li|h\d)>/gi,'\n');
  return new DOMParser().parseFromString('<body>'+h,'text/html').body.textContent.replace(/\u00a0/g,' ');
}
function rtHtml(s){
