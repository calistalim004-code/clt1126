.wheelbox{position:relative;width:min(340px,86vw);margin:12px auto 0}
.ptr{position:absolute;left:50%;top:-14px;transform:translateX(-50%);font-size:2rem;line-height:1;z-index:2;color:var(--danger)}
.wheel{width:100%;height:auto;display:block;border-radius:50%;filter:drop-shadow(0 6px 14px rgba(40,80,120,.25))}
.wctl{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:16px 0}
.qs{margin-bottom:14px}
.qs .tag{display:inline-block;margin:0 0 4px 4px;padding:1px 12px;border-radius:999px;font-weight:700;font-size:.9rem;background:var(--accent-soft)}
.qs textarea{min-height:110px;font-size:1.05rem;line-height:1.9;border-color:transparent}
.score{font-size:3rem;font-weight:700;text-align:center;margin:6px 0}
.rsec{background:var(--card);border:2px solid var(--line);border-radius:20px;padding:12px 16px;margin-bottom:10px}
.rsec h3{margin:0 0 6px;display:flex;justify-content:space-between;font-size:1.05rem}
.pt{padding:2px 0}
textarea{resize:none;overflow:hidden}
.tabs button.tb-zxt{background:var(--t3)}
.cmpbar{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px}
.cmpbar>b{padding-top:6px;min-width:5em}
.pills{display:flex;gap:8px;flex-wrap:wrap;flex:1}
.pill[aria-pressed="true"]{background:var(--accent);color:#0F2840;border-color:var(--accent);font-weight:700}
.ct{margin:18px 0 4px;font-size:1.05rem}
.tblwrap{overflow-x:auto;margin:10px 0 18px;border:2px solid var(--line);border-radius:18px;background:var(--card)}
table.cmp{border-collapse:separate;border-spacing:0;min-width:100%;font-size:.95rem}
.cmp th,.cmp td{padding:10px 12px;vertical-align:top;text-align:left;border-bottom:1px solid var(--line);border-right:1px solid var(--line);min-width:150px}
.cmp thead th{background:var(--accent-soft)}
.cmp tbody th{background:var(--panel);position:sticky;left:0;min-width:96px}
.cmp ul{margin:0;padding-left:1.1em}
.cmp .nil{color:var(--muted)}
.cmp tr:last-child th,.cmp tr:last-child td{border-bottom:0}
.cmp th:last-child,.cmp td:last-child{border-right:0}
.rt{min-height:90px;padding:9px 14px;border:2px solid transparent;border-radius:16px;background:var(--card);color:var(--ink);font-size:1.05rem;line-height:1.9;overflow-wrap:anywhere;outline:0}
.rt:focus{border-color:var(--focus)}
.rt ul,.rt ol{margin:0;padding-left:1.4em}
.rt p,.rt div{margin:0}
.panel>.fld .rt{font-size:1.1rem;line-height:1.95;min-height:240px}
.f-etio .rt{background:var(--t1)}.f-diag .rt{background:var(--t2)}.f-diff .rt{background:var(--t3)}.f-bzyd .rt{background:var(--t6)}.f-pri .rt{background:var(--t4)}
.l-sym .rt{background:var(--t4)}.l-tx .rt{background:var(--t3)}.l-fm .rt{background:var(--t5)}.l-zh .rt{background:var(--t6)}
.zhrow .rt{min-height:60px}
[style*="background-color"]{color:#27425E}
.fmtbar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;position:sticky;top:8px;z-index:3;background:var(--panel);border:2px solid var(--line);border-radius:18px;padding:6px 10px;margin-bottom:10px}
.fmtbar button{padding:4px 12px}
.fmthint{color:var(--muted);font-size:.85rem;margin-left:auto}
@media (max-width:720px){.zhrow .rt{grid-column:1/3;grid-row:2}}
.tc0{--bc:var(--t1)}.tc1{--bc:var(--t2)}.tc2{--bc:var(--t3)}.tc3{--bc:var(--t4)}.tc4{--bc:var(--t5)}.tc5{--bc:var(--t6)}
.pt.ok::before{content:"✅ "}.pt.part::before{content:"🟡 "}.pt.no::before{content:"❌ "}
.zx{padding:10px 12px}
.zx:not(.open) .zxhead{margin-bottom:0}
.tog{padding:4px 12px;flex:none}
.tog::before{content:"▸"}.zx.open .tog::before{content:"▾"}
.zbody{display:none;margin-top:4px}.zx.open .zbody{display:block}
.sub{margin-bottom:8px}
.subh{border:0;background:transparent;padding:2px 0;border-radius:999px}
.subh:hover{background:transparent;transform:none}
.sub .tag{margin:0;cursor:pointer}
.sub .tag::before{content:"▸ "}.sub.open .tag::before{content:"▾ "}
.sub.has .tag::after{content:" ✓"}
.subbody{display:none;margin:6px 0 4px}.sub.open .subbody{display:block}
.sub textarea{min-height:90px;color:var(--ink);font-size:1.05rem;line-height:1.9;border-color:transparent}
.mini{display:block;margin:8px 0 3px 4px;color:var(--muted);font-size:.85rem}
.subbody .mini:first-child{margin-top:0}
.sub textarea+.mini{margin-top:16px}
.l-zh .tag,.l-zh textarea{background:var(--t6)}
.mmwrap{overflow-x:auto;padding:8px 4px 12px}
.mm ul{list-style:none;margin:0;padding:0}
.mm li{display:flex;align-items:center;position:relative;padding:4px 0 4px 26px}
.mm li::before{content:"";position:absolute;left:0;top:50%;width:26px;border-top:2px solid var(--line)}
.mm li::after{content:"";position:absolute;left:0;top:0;bottom:0;border-left:2px solid var(--line)}
.mm li:first-child::after{top:50%}.mm li:last-child::after{bottom:50%}.mm li:only-child::after{display:none}
.mm li>ul{position:relative;margin-left:26px;display:flex;flex-direction:column;justify-content:center}
.mm li>ul::before{content:"";position:absolute;left:-26px;top:50%;width:26px;border-top:2px solid var(--line)}
.mm>ul>li{padding-left:0}
.mm>ul>li::before,.mm>ul>li::after{display:none}
.mm .node{display:block;max-width:230px;padding:6px 12px;border-radius:14px;background:var(--card);border:2px solid var(--bc,var(--line));line-height:1.5;word-break:break-word;font-size:.95rem}
.mm li.root>.node{background:var(--accent);color:#0F2840;font-weight:700;font-size:1.1rem;border-color:var(--accent)}
.mm li.l1>.node{background:var(--bc);font-weight:700}
.b-etio{--bc:var(--t1)}.b-diag{--bc:var(--t2)}.b-diff{--bc:var(--t3)}.b-bzyd{--bc:var(--t6)}.b-pri{--bc:var(--t4)}.b-zx{--bc:var(--t5)}
.recite>.fld:not(.shown) textarea,.recite>.fld:not(.shown) .rt{filter:blur(8px);pointer-events:none}
.recite>.fld:not(.shown){cursor:pointer}
.recite>.fld:not(.shown)::after{content:"👆 点一下看答案";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--ink)}
.saved{color:var(--muted);font-size:.85rem;margin-top:8px;min-height:1.4em}
dialog{width:min(620px,94vw);border:2px solid var(--line);border-radius:24px;background:var(--card);color:var(--ink);padding:20px}
dialog::backdrop{background:rgba(20,40,60,.45)}
.dlgacts{display:flex;gap:8px;justify-content:flex-end;margin-top:14px}
.hint{color:var(--muted)}
footer{margin-top:28px;color:var(--muted);font-size:.85rem}
body.viewer #main .adder,body.viewer #main .fmtbar,body.viewer #main button.danger,body.viewer #main [data-act="add"],body.viewer #main [data-act="addz"],body.viewer #main [data-act="addzh"],body.viewer #main [data-act="delzh"],body.viewer #main [data-act="delz"],body.viewer #main [data-act="deltopic"]{display:none!important}
body.viewer #main input:not([type="search"]),body.viewer #main textarea,body.viewer #main .rt{pointer-events:none;opacity:.88}
body.viewer #bkImport{display:none!important}
@media (max-width:720px){
  .layout{grid-template-columns:1fr}
  nav{position:static;display:flex;overflow-x:auto;gap:4px}
  nav button{width:auto;white-space:nowrap}
  .zgrid{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){button{transition:none}button:hover,.chip:hover{transform:none}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🩺 中医内科学笔记</h1>
    <p>选分类，添加病证，点进去按病因病机、诊断等分栏填写。写的内容自动保存。</p>
  </header>
  <div class="bar">
    <input id="q" type="search" placeholder="搜索病证或笔记内容" aria-label="搜索笔记">
    <button id="backup">备份与导入</button>
    <button id="adminLogin">管理员登录</button>
    <button id="theme">深浅色</button>
  </div>
  <div class="layout">
    <nav id="nav" aria-label="病证分类"></nav>
    <main id="main"></main>
  </div>
  <footer><span id="cloudStatus">正在连接云端……</span> · 建议定期用“备份与导入”保存备份。</footer>
</div>

<dialog id="bk">
  <h2>备份与导入</h2>
  <p class="hint">复制下面的文字存到备忘录就是备份。换设备时粘贴回来点“导入”，会覆盖当前笔记。</p>
  <textarea id="bkText" rows="9"></textarea>
  <div class="dlgacts"><button type="button" id="bkClose">关闭</button><button type="button" class="primary" id="bkImport">导入</button></div>
  <p class="hint" id="bkMsg"></p>
</dialog>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/13.4.0/firebase-app.js";
import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";
import { getFirestore, doc, getDoc, setDoc, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/13.4.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyBV6V_AHeDFccYaPMBgYHNbIRW485DAXE4",
  authDomain: "tcm-notes.firebaseapp.com",
  projectId: "tcm-notes",
  storageBucket: "tcm-notes.firebasestorage.app",
  messagingSenderId: "291947727241",
  appId: "1:291947727241:web:c7cc0fd4b462b1213cf958",
  measurementId: "G-KTEGEWZD2M"
};
const firebaseApp = initializeApp(firebaseConfig);
const auth = getAuth(firebaseApp);
const db = getFirestore(firebaseApp);
const noteRef = doc(db, "notes", "main");
let cloudReady=false, cloudOwner=false, cloudUnsubscribe=null, currentUser=null, cloudWriteChain=Promise.resolve();

const KEY='neike-notes-v3';
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const TABS=[['etio','病因病机','🌱'],['diag','诊断','🔍'],['diff','鉴别诊断','⚖️'],['pri','治则治法','🧭'],['zx','常见证型','📋']];
const PH={etio:'• 每行写一个要点，按回车自动变成下一个小圆点',diag:'• 每行一个诊断要点',diff:'• 和哪个病证鉴别，区别在哪',pri:'• 治则\n• 治法'};
const seed=()=>[["肺系病证","🫁"],["心系病证","💗"],["脑系病证","🧠"],["脾胃系病证","🍚"],["肝系病证","🌿"],["肾系病证","💧"],["气血津液病证","🩸"],["经络肢体病证","🦴"]].map(([sys,em])=>({sys,em,items:[]}));
TABS.splice(3,0,['bzyd','辨证要点','🎯']);TABS.push(['map','思维导图','🗺️']);PH.bzyd='• 每行一个辨证要点';TABS.splice(6,0,['zxt','证型对比表','📊']);
const zopen=new Set(),zsub=new Set();
let mode=null;
const W={stage:'wheel',rot:0,cat:'all',seg:null,segCat:null,pick:null,ans:{},res:null,spinning:false};
let DATA,cur=0,open=null,delArm=false,memOnly=false,timer=null,recite=false;
try{const s=localStorage.getItem(KEY);if(s){const d=JSON.parse(s);if(Array.isArray(d)&&d.length)DATA=d;}}catch(e){memOnly=true;}
if(!DATA)DATA=seed();
function persist(){
  try{localStorage.setItem(KEY,JSON.stringify(DATA));setSaved('已在本机保存');}
  catch(e){memOnly=true;setSaved('本机保存失败，请用备份');}
  if(cloudReady && cloudOwner && currentUser){
    const payload=JSON.parse(JSON.stringify(DATA));
    cloudWriteChain=cloudWriteChain.then(()=>setDoc(noteRef,{data:payload,updatedAt:serverTimestamp()}))
      .then(()=>setCloudStatus('☁️ 已同步到云端'))
      .catch(e=>{console.error(e);setCloudStatus('云端保存失败：请检查 Firestore Rules');setSaved('云端保存失败，请勿关闭页面并检查网络');});
  }
}
function setSaved(t){const el=document.getElementById('saved');if(el)el.textContent=t;}
function scheduleSave(){setSaved('保存中……');clearTimeout(timer);timer=setTimeout(persist,400);}
const filled=t=>[t.etio,t.diag,t.diff,t.bzyd,t.pri].filter(x=>hv(x)).length+(t.zx.length?1:0);
const nav=$('nav'),main=$('main'),q=$('q');

function renderNav(){
  nav.innerHTML='';
  DATA.forEach((s,i)=>{
    const b=document.createElement('button');
    b.textContent=(s.em||'📘')+' '+s.sys;
    if((!mode||mode==='cmp')&&(!q.value&&!open&&i===cur||!q.value&&open&&i===open.ci))b.setAttribute('aria-current','true');
    b.onclick=()=>{cur=i;open=null;mode=null;q.value='';render();};
    nav.appendChild(b);
  });
}
function zhGet(z){if(!Array.isArray(z.zha))z.zha=hv(z.zh)?[{s:'',a:String(z.zh)}]:[];return z.zha;}
