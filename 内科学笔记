    if(zk.length)parts.push(mmNode('证候分析',zk));
    [['tx','治法']].forEach(p=>{const kids=L(z[p[0]]);if(kids.length)parts.push(mmNode(p[1],kids));});
    const herbs=plainText(z.comp).split(/[、，,；;\n•]+/).map(x=>x.trim()).filter(Boolean).map(x=>mmNode(x));
    const fm=lines(z.fm).join('、');
    if(fm||herbs.length)parts.push(mmNode(fm?'方药：'+fm:'方药',herbs));
    return (parts.length||(z.n&&z.n.trim()))?mmNode(z.n&&z.n.trim()?z.n:'未命名证型',parts):'';
  }).filter(Boolean);
  if(zs.length)br.push(mmNode('常见证型',zs,'l1 b-zx'));
  if(!br.length)return '<div class="empty">还没有内容。先在各个分栏里填写，这里会自动生成思维导图。</div>';
  return '<div class="mmwrap"><div class="mm"><ul>'+mmNode(t.n||'病证',br,'root')+'</ul></div></div>';
}
function panel(t,tab){
  if(tab==='zx')return zxPanel(t);
  if(tab==='zxt')return zxTable(t);
  if(tab==='map')return mmMap(t);
  return panelOld(t,tab);
}
function panelOld(t,tab){
  if(tab==='zx'){
    const rows=t.zx.map((z,i)=>'<div class="zx" data-z="'+i+'"><div class="zxhead"><input data-k="n" placeholder="证型名称，例如：风寒束表" value="'+esc(z.n)+'" aria-label="证型名称"><button class="danger" data-act="delz">删除</button></div><div class="zgrid">'+
      '<div class="l-sym"><span class="tag">🤒 症状</span><div class="fld"><textarea data-k="sym" aria-label="症状">'+esc(z.sym)+'</textarea></div></div>'+
      '<div class="l-tx"><span class="tag">🧭 治法</span><div class="fld"><textarea data-k="tx" aria-label="治法">'+esc(z.tx)+'</textarea></div></div>'+
      '<div class="l-fm"><span class="tag">🍵 方药</span><div class="fld"><textarea data-k="fm" aria-label="方药">'+esc(z.fm)+'</textarea></div></div>'+
      '<div class="l-comp"><span class="tag">🌿 组成</span><div class="fld"><textarea data-k="comp" aria-label="组成">'+esc(z.comp)+'</textarea></div></div></div></div>').join('');
    return (rows||'<div class="empty">还没有证型。点下面的按钮添加一个。</div>')+'<button class="primary" data-act="addz" style="margin-top:6px">＋ 添加证型</button>';
  }
  return '<div class="fld f-'+tab+'">'+rtDiv('data-f="'+tab+'"',TABS.find(x=>x[0]===tab)[1],t[tab])+'</div>';
}
function viewTopic(){
  const s=DATA[open.ci],t=s.items[open.ti];
  const tabs=TABS.map(([k,l,e])=>{
    const has=k==='zx'?t.zx.length:hv(t[k]);
    return '<button role="tab" class="tb-'+k+'" data-tab="'+k+'" aria-selected="'+(open.tab===k)+'">'+e+' '+l+(has?'<i>✓</i>':'')+'</button>';
  }).join('');
  return '<button class="back" data-act="back">← 返回 '+esc(s.sys)+'</button>'+
    '<div class="thead"><input id="tname" value="'+esc(t.n)+'" aria-label="病证名称"><button class="danger" data-act="deltopic">'+(delArm?'再点确认删除':'删除病证')+'</button></div>'+
    '<div class="tabs" role="tablist">'+tabs+'<button class="rbtn" data-act="recite" aria-pressed="'+recite+'">'+(recite?'👀 退出背诵':'🧠 背诵模式')+'</button></div>'+(open.tab==='map'||open.tab==='zxt'?'':FMT)+'<div class="panel'+(recite?' recite':'')+'">'+panel(t,open.tab)+'<div class="saved" id="saved"></div></div>';
}
function render(){
  document.body.classList.toggle("viewer",!cloudOwner);
  $("adminLogin").textContent=cloudOwner?"管理员已登录 · 退出":"管理员登录";
  renderNav();
  const kw=q.value.trim().toLowerCase();
  addWheelBtn();main.innerHTML=kw?viewSearch(kw):mode==='wheel'?viewWheel():mode==='cmp'?viewCmp():open?viewTopic():viewCat();fitAll();
}

main.addEventListener('click',e=>{
  const fb=e.target.closest('[data-fmt]');if(fb){fmtCmd(fb.dataset.fmt);return;}
  const fl=e.target.closest('.recite>.fld:not(.shown)');if(fl){fl.classList.add('shown');return;}
  const c=e.target.closest('.chip');
  if(c){const [ci,ti]=c.dataset.open.split('-').map(Number);open={ci,ti,tab:'etio'};cur=ci;q.value='';delArm=false;recite=false;zopen.clear();zsub.clear();mode=null;render();return;}
  const tb=e.target.closest('[data-tab]');
  if(tb){open.tab=tb.dataset.tab;render();return;}
  const b=e.target.closest('[data-act]');if(!b)return;
  const a=b.dataset.act;
  if(!cloudOwner && ['add','addzh','delzh','addz','delz','deltopic'].includes(a))return;
  if(a==='add'){
    const inp=$('newT'),n=inp.value.trim();
    if(!n){inp.focus();return;}
    DATA[cur].items.push({n,etio:'',diag:'',diff:'',bzyd:'',pri:'',zx:[]});persist();render();return;
  }
  if(a==='cmpt'||a==='cmpm'){openCmp(a==='cmpt'?'table':'map');return;}
  if(a==='cback'){mode=null;render();return;}
  if(a==='ctopic'){const i=+b.dataset.i;if(C.sel.has(i))C.sel.delete(i);else C.sel.add(i);render();return;}
  if(a==='cfield'){const k=b.dataset.k;if(C.fields.has(k))C.fields.delete(k);else C.fields.add(k);render();return;}
  if(a==='cdeep'){C.deep=!C.deep;render();return;}
  if(a==='csall'){C.sel=new Set(DATA[C.ci].items.map((_,i)=>i));render();return;}
  if(a==='csnone'){C.sel=new Set();render();return;}
  if(a==='spin'){
    if(W.spinning)return;
    const seg=W.seg.length===1?[W.seg[0],W.seg[0]]:W.seg;
    const n=seg.length,ang=360/n,idx=Math.floor(Math.random()*n),center=(idx+.5)*ang+(Math.random()-.5)*ang*.5;
    W.rot+=360*5+((((360-center)-(W.rot%360))%360)+360)%360;
    const svg=$('wheel'),ms=matchMedia('(prefers-reduced-motion:reduce)').matches?300:4200;
    W.spinning=true;$('spinBtn').disabled=true;
    svg.style.transition='transform '+ms+'ms cubic-bezier(.12,.7,.15,1)';
    svg.style.transform='rotate('+W.rot+'deg)';
    setTimeout(()=>{W.spinning=false;if(mode!=='wheel')return;W.pick=seg[idx];W.ans={};W.stage='quiz';render();},ms+300);
    return;
  }
  if(a==='reshuffle'){W.seg=null;render();return;}
  if(a==='qwheel'){W.stage='wheel';render();return;}
  if(a==='grade'){gradeNow();render();return;}
  if(a==='again'){W.stage='wheel';render();return;}
  if(a==='retry'){W.ans={};W.stage='quiz';render();return;}
  if(a==='opennote'){mode=null;open={ci:W.pick.ci,ti:W.pick.ti,tab:'etio'};cur=W.pick.ci;zopen.clear();zsub.clear();render();return;}
  if(a==='togz'){const z=b.closest('.zx'),i=+z.dataset.z;z.classList.toggle('open');const o=z.classList.contains('open');if(o)zopen.add(i);else zopen.delete(i);b.setAttribute('aria-expanded',o);fitAll();return;}
  if(a==='togsub'){const s=b.closest('.sub'),k=s.dataset.sk;s.classList.toggle('open');const o=s.classList.contains('open');if(o)zsub.add(k);else zsub.delete(k);b.setAttribute('aria-expanded',o);fitAll();return;}
  if(a==='recite'){recite=!recite;render();return;}
  if(a==='back'){open=null;delArm=false;recite=false;render();return;}
  const t=open&&DATA[open.ci].items[open.ti];
  if(a==='addzh'){const z=t.zx[+b.closest('.zx').dataset.z];zhGet(z).push({s:'',a:''});persist();render();return;}
  if(a==='delzh'){const z=t.zx[+b.closest('.zx').dataset.z];zhGet(z).splice(+b.closest('.zhrow').dataset.zi,1);persist();render();return;}
  if(a==='addz'){t.zx.push({n:'',sym:'',zha:[{s:'',a:''}],tx:'',fm:'',comp:''});zopen.add(t.zx.length-1);persist();render();return;}
  if(a==='delz'){t.zx.splice(+b.closest('.zx').dataset.z,1);zopen.clear();zsub.clear();persist();render();return;}
  if(a==='deltopic'){
    if(delArm){DATA[open.ci].items.splice(open.ti,1);open=null;delArm=false;persist();render();}
    else{delArm=true;b.textContent='再点确认删除';}
  }
});
main.addEventListener('input',e=>{
  if(!cloudOwner && e.target.dataset.q===undefined)return;
  if(e.target.tagName==='TEXTAREA')autoSize(e.target);
  if(e.target.dataset.q!==undefined){W.ans[e.target.dataset.q]=e.target.value;return;}
  if(!open)return;
  const el=e.target,t=DATA[open.ci].items[open.ti];
  if(el.id==='tname')t.n=el.value;
  else if(el.dataset.f)t[el.dataset.f]=fv(el);
  else if(el.dataset.zk){const zz=t.zx[+el.closest('.zx').dataset.z];zhGet(zz)[+el.closest('.zhrow').dataset.zi][el.dataset.zk]=fv(el);const sb2=el.closest('.sub');if(sb2)sb2.classList.toggle('has',zhHas(zz));}
  else if(el.dataset.k){t.zx[+el.closest('.zx').dataset.z][el.dataset.k]=fv(el);const sb=el.closest('.sub');if(sb)sb.classList.toggle('has',[...sb.querySelectorAll('.rt')].some(x=>hv(x.innerHTML)));}
  else return;
  scheduleSave();
});
main.addEventListener('keydown',e=>{
  if(e.isComposing||e.keyCode===229)return;
  const el=e.target;
  if(e.key==='Enter'&&el.id==='newT'){e.preventDefault();main.querySelector('[data-act="add"]').click();return;}
  if(e.key==='Enter'&&el.tagName==='TEXTAREA'){
    e.preventDefault();
    const v=el.value,s=el.selectionStart,ls=v.lastIndexOf('\n',s-1)+1;
    if(v.slice(ls,s).trim()==='•')el.setRangeText('',ls,s,'end');
    else el.setRangeText('\n• ',s,el.selectionEnd,'end');
    el.dispatchEvent(new Event('input',{bubbles:true}));
  }
});
main.addEventListener('focusin',e=>{
  const el=e.target;
  if(el.tagName==='TEXTAREA'&&!el.value.trim()){el.value='• ';el.setSelectionRange(2,2);}
});
main.addEventListener('focusout',e=>{
  const el=e.target;
  if(el.tagName==='TEXTAREA'&&el.value.trim()==='•')el.value='';
});
q.addEventListener('input',()=>{if(q.value)open=null;render();});
main.addEventListener('change',e=>{if(e.target.id==='wcat'){W.cat=e.target.value;W.seg=null;render();}});
window.addEventListener('resize',fitAll);
main.addEventListener('mousedown',e=>{if(e.target.closest('[data-fmt]'))e.preventDefault();});
main.addEventListener('paste',e=>{if(e.target.closest&&e.target.closest('.rt')){e.preventDefault();const tx=(e.clipboardData||window.clipboardData).getData('text/plain');document.execCommand('insertText',false,tx);}});
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fitAll);

$('backup').onclick=()=>{$('bkText').value=JSON.stringify(DATA);$('bkMsg').textContent='';$('bk').showModal();};
$('bkClose').onclick=()=>$('bk').close();
$('bkImport').onclick=()=>{
  if(!cloudOwner){$('bkMsg').textContent='只有管理员登录后才能导入并更新公开笔记。';return;}
  try{
    const d=JSON.parse($('bkText').value);
    if(!Array.isArray(d)||!d.every(s=>s&&typeof s.sys==='string'&&Array.isArray(s.items)))throw 0;
    d.forEach(s=>s.items.forEach(t=>{t.zx=Array.isArray(t.zx)?t.zx:[];}));
    DATA=d;cur=0;open=null;persist();render();$('bk').close();
  }catch(e){$('bkMsg').textContent='导入失败，请粘贴完整的备份文字。';}
};
$('theme').onclick=()=>{
  const r=document.documentElement;
  const dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
  r.dataset.theme=dark?'light':'dark';
};
function setCloudStatus(s){const el=$("cloudStatus");if(el)el.textContent=s;}
$('adminLogin').onclick=async()=>{
  try{
    if(auth.currentUser){await signOut(auth);return;}
    const provider=new GoogleAuthProvider();
    await signInWithPopup(auth,provider);
  }catch(e){console.error(e);setCloudStatus('登录失败：'+(e.code||e.message));alert('管理员登录失败：'+(e.code||e.message)+'。请确认 Firebase Authentication 已启用 Google 登录，并已添加 GitHub Pages 域名。');}
};
onAuthStateChanged(auth,async user=>{
  currentUser=user;cloudOwner=!!user && user.email === "calistalim004@gmail.com";cloudReady=false;
  if(cloudUnsubscribe){cloudUnsubscribe();cloudUnsubscribe=null;}
  render();
  setCloudStatus(user?'管理员已登录，正在读取云端笔记……':'公开查看模式：正在读取最新笔记……');
  try{
    cloudUnsubscribe=onSnapshot(noteRef,async snap=>{
      if(snap.exists()){
        const remote=snap.data().data;
        if(Array.isArray(remote)&&remote.length){
          const changed=JSON.stringify(DATA)!==JSON.stringify(remote);
          if(changed){DATA=remote;cur=Math.min(cur,DATA.length-1);if(open&&!DATA[open.ci]?.items?.[open.ti])open=null;try{localStorage.setItem(KEY,JSON.stringify(DATA));}catch(e){}render();}
        }
        cloudReady=true;
        setCloudStatus(cloudOwner?'☁️ 管理员模式：云端实时同步已连接':'☁️ 公开查看：已加载最新笔记');
      }else if(cloudOwner){
        // First owner visit: migrate existing browser notes into the shared cloud document.
        await setDoc(noteRef,{data:DATA,updatedAt:serverTimestamp()});
        cloudReady=true;setCloudStatus('☁️ 已将本机笔记上传到云端');
      }else{
        cloudReady=true;setCloudStatus('等待管理员首次上传笔记……');
      }
    },err=>{console.error(err);setCloudStatus('读取云端失败：请检查 Firestore Rules');});
  }catch(e){console.error(e);setCloudStatus('连接云端失败：'+(e.code||e.message));}
});
render();
