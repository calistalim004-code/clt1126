<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>中医内科学读书笔记</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
:root{
  --bg:#E6F1FC; --panel:#F5FAFF; --card:#FFFFFF; --line:#C5DDF3;
  --accent:#7FB4EA; --accent-soft:#D3E7F9; --ink:#24405C; --muted:#5C7894; --focus:#3F7FBF; --danger:#B4455A;
  --t1:#CFE6FA; --t2:#DCE1FB; --t3:#CFEFE8; --t4:#FBE0EA; --t5:#FFF0C4;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#15212E; --panel:#1B2939; --card:#223346; --line:#32475E;
    --accent:#6FA3D6; --accent-soft:#2A4460; --ink:#E3EEF9; --muted:#9DB5CC; --focus:#8DBBE8; --danger:#E58A9B;
    --t1:#27465F; --t2:#32375F; --t3:#24514D; --t4:#5A3445; --t5:#5A4E26;
  }
}
:root[data-theme="dark"]{
  --bg:#15212E; --panel:#1B2939; --card:#223346; --line:#32475E;
  --accent:#6FA3D6; --accent-soft:#2A4460; --ink:#E3EEF9; --muted:#9DB5CC; --focus:#8DBBE8; --danger:#E58A9B;
  --t1:#27465F; --t2:#32375F; --t3:#24514D; --t4:#5A3445; --t5:#5A4E26;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.7 "Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif}
.wrap{max-width:1040px;margin:0 auto;padding:26px 18px 56px}
h1,h2{font-weight:700}
h1{margin:0;font-size:2.2rem;letter-spacing:.05em}
h2{margin:0;font-size:1.6rem}
header{padding:4px 0 18px}
header p{margin:4px 0 0;color:var(--muted)}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
input,textarea{font:inherit;color:var(--ink);background:var(--card);border:2px solid var(--line);border-radius:16px;padding:9px 14px;width:100%}
textarea{resize:vertical;line-height:1.7}
.bar input{flex:1;min-width:200px;border-radius:999px;padding:10px 18px;width:auto}
button{font:inherit;color:var(--ink);background:var(--card);border:2px solid var(--line);border-radius:999px;padding:8px 16px;cursor:pointer;transition:transform .15s}
button:hover{background:var(--accent-soft);transform:translateY(-2px)}
button.primary{background:var(--accent);color:#0F2840;border-color:var(--accent);font-weight:700}
button.danger{color:var(--danger)}
:is(input,textarea,button):focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.layout{display:grid;grid-template-columns:210px 1fr;gap:20px;align-items:start}
nav{background:var(--panel);border:2px solid var(--line);border-radius:26px;padding:10px;position:sticky;top:12px}
nav button{display:block;width:100%;text-align:left;border:0;border-radius:16px;background:transparent;margin:3px 0;padding:10px 14px}
nav button:hover{background:var(--accent-soft)}
nav button[aria-current="true"]{background:var(--accent);color:#0F2840;font-weight:700}
.head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}
.adder{display:flex;gap:10px;margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
.chip{text-align:left;border-radius:22px;border:0;padding:14px 16px;min-height:84px;display:flex;flex-direction:column;justify-content:space-between;background:var(--t1)}
.chip:nth-child(5n+2){background:var(--t2)}.chip:nth-child(5n+3){background:var(--t3)}
.chip:nth-child(5n+4){background:var(--t4)}.chip:nth-child(5n+5){background:var(--t5)}
.chip:hover{transform:translateY(-3px) rotate(-1deg);filter:brightness(.98)}
.chip b{font-size:1.1rem}
.chip small{color:var(--muted)}
.empty{padding:30px;text-align:center;color:var(--muted);background:var(--panel);border:2px dashed var(--line);border-radius:24px}
.back{margin-bottom:12px}
.thead{display:flex;gap:10px;align-items:center;margin-bottom:14px}
.thead input{font-weight:700;font-size:1.3rem;border-radius:18px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.tabs button{border:2px solid transparent;border-radius:999px}
.tabs button:nth-child(1){background:var(--t1)}.tabs button:nth-child(2){background:var(--t2)}
.tabs button:nth-child(3){background:var(--t3)}.tabs button:nth-child(4){background:var(--t4)}
.tabs button:nth-child(5){background:var(--t5)}
.tabs button[aria-selected="true"]{border-color:var(--ink);font-weight:700}
.tabs i{font-style:normal;font-size:.8rem;margin-left:4px;color:var(--muted)}
.panel{background:var(--panel);border:2px solid var(--line);border-radius:26px;padding:18px}
.panel textarea{min-height:240px}
.zx{background:var(--card);border:2px solid var(--line);border-left:8px solid var(--accent);border-radius:20px;padding:12px;margin-bottom:12px}
.zxhead input{font-weight:700;font-size:1.1rem}
.zxhead{display:flex;gap:8px;margin-bottom:8px}
.zgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.zgrid label{color:var(--muted);font-size:.9rem}
.zgrid textarea{min-height:96px;color:var(--ink);font-size:1.05rem;line-height:1.9;border-color:transparent}
.tag{display:inline-block;margin:0 0 4px 4px;padding:1px 12px;border-radius:999px;font-weight:700;font-size:.9rem;color:var(--ink)}
.l-sym .tag,.l-sym textarea{background:var(--t4)}
.l-tx .tag,.l-tx textarea{background:var(--t3)}
.l-fm .tag,.l-fm textarea{background:var(--t5)}
.l-comp .tag,.l-comp textarea{background:var(--t2)}
.f-etio textarea{background:var(--t1)}.f-diag textarea{background:var(--t2)}.f-diff textarea{background:var(--t3)}.f-pri textarea{background:var(--t4)}
.panel>.fld textarea{font-size:1.1rem;line-height:1.95;border-color:transparent}
.fld{position:relative}
.rbtn{margin-left:auto}
.tabs button.tb-etio{background:var(--t1)}.tabs button.tb-diag{background:var(--t2)}.tabs button.tb-diff{background:var(--t3)}
.tabs button.tb-bzyd{background:var(--t6)}.tabs button.tb-pri{background:var(--t4)}.tabs button.tb-zx{background:var(--t5)}.tabs button.tb-map{background:var(--accent)}
