function bg(s){const c=String(s).replace(/[\s•，。、；：,.;:（）()\-—]/g,'');const r=new Set();for(let i=0;i<c.length-1;i++)r.add(c.slice(i,i+2));if(c.length===1)r.add(c);return r;}
